#!/bin/sh
# Strips AI-tool Co-Authored-By trailers from commit messages before they are recorded.
# Human co-authors (e.g. Co-Authored-By: Name <name@company.com>) are preserved.
#
# Enable (once per clone): git config core.hooksPath .githooks

COMMIT_MSG_FILE=$1
[ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ] || exit 0

tmp=$(mktemp "${TMPDIR:-/tmp}/catalyst-commit-msg.XXXXXX") || exit 0
if ! sed -E \
  -e '/^Co-Authored-By:.*anthropic\.com>/d' \
  -e '/^Co-Authored-By:.*[Cc]laude/d' \
  "$COMMIT_MSG_FILE" > "$tmp"
then
  rm -f "$tmp"
  exit 1
fi
if ! mv "$tmp" "$COMMIT_MSG_FILE"
then
  rm -f "$tmp"
  exit 1
fi
exit 0
