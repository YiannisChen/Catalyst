# Catalyst data-core local credentials.
#
# Setup:
#   cp packages/data-core/.env.template packages/data-core/.env
#   chmod 600 packages/data-core/.env
#
# The B2-O CLI loads packages/data-core/.env automatically. This file is a
# tracked template only. Never put real credentials in this template or commit
# packages/data-core/.env.

# Required to construct the B2-O live transport.
POLYGON_API_KEY=""
FINNHUB_API_KEY=""
FRED_API_KEY=""

# Required for the remaining B2-O FMP fundamental cells.
FMP_API_KEY=""

# SEC EDGAR requires a descriptive User-Agent containing contact information.
# Example format: Catalyst your-email@example.com
SEC_USER_AGENT=""

# Optional; not used by the B2-O FMP/FRED backfill.
GEMINI_API_KEY=""
