# API: served read-only corpus SQLite file; default is the local runtime data directory.
CATALYST_DB_PATH=
# API: separate writable database for runs, events, and quotas.
CATALYST_RUNTIME_DB_PATH=
# API: runtime directory used to derive default store paths.
CATALYST_RUNTIME_DATA_DIR=
# API: optional explicit market context SQLite file.
CATALYST_MARKET_CONTEXT_DB=
# API: optional explicit news body SQLite file.
CATALYST_NEWS_BODIES_DB=
# API and daily job: optional resumable update-jobs SQLite file.
CATALYST_UPDATE_JOBS_DB=
# API and daily job: optional headline archive SQLite file.
CATALYST_HEADLINE_ARCHIVE_DB=
# API: optional peer map manifest path.
CATALYST_PEER_MAP=data/manifests/peer_map_v1.json
# API: comma-separated accepted Host header values.
CATALYST_ALLOWED_HOSTS=localhost,127.0.0.1
# API: comma-separated allowed browser origins.
CATALYST_ALLOWED_ORIGINS=http://localhost:5173
# API: set to 1 only behind a trusted reverse proxy for public access.
CATALYST_ALLOW_NON_LOOPBACK=0
# API: trusted reverse proxy CIDRs.
CATALYST_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# API: optional private admin endpoint token; set only in deployment secrets.
CATALYST_ADMIN_TOKEN=
# API: invite token signing key; set only in deployment secrets.
CATALYST_INVITE_SIGNING_KEY=
# API: quota identity hash key; set only in deployment secrets.
CATALYST_QUOTA_HASH_KEY=
# API: Cloudflare Turnstile secret; set only in deployment secrets.
CATALYST_TURNSTILE_SECRET_KEY=
# API: expected Turnstile action when verification is enabled.
CATALYST_TURNSTILE_EXPECTED_ACTION=
# API: anonymous daily run quota.
CATALYST_ANONYMOUS_DAILY_RUN_LIMIT=5
# API: invite daily run quota.
CATALYST_INVITE_DAILY_RUN_LIMIT=50
# API: anonymous BYOK daily run quota.
CATALYST_ANONYMOUS_BYOK_DAILY_RUN_LIMIT=20
# API: maximum daily model spend budget in USD.
CATALYST_DAILY_MODEL_BUDGET_USD=2.00
# API: maximum model cost for a single run in USD.
CATALYST_MAX_RUN_MODEL_COST_USD=0.05
# API: maximum daily Tavily calls.
CATALYST_DAILY_TAVILY_CALL_LIMIT=50
# API: optional service-side default provider model identifier.
CATALYST_DEFAULT_MODEL=
# API: optional pricing JSON path.
CATALYST_PRICING_FILE=
# API: optional override pricing JSON document.
CATALYST_MODEL_PRICES_JSON=
# API: optional public URL included in administrator notifications.
CATALYST_PUBLIC_URL=
# API: SMTP server for administrator notifications.
CATALYST_SMTP_HOST=
# API: SMTP server port.
CATALYST_SMTP_PORT=465
# API: SMTP account name.
CATALYST_SMTP_USER=
# API: SMTP password; set only in deployment secrets.
CATALYST_SMTP_PASSWORD=
# API: notification sender address.
CATALYST_NOTIFY_FROM=
# API: administrator notification recipient address.
CATALYST_ADMIN_NOTIFY_EMAIL=
# API: set to 1 to use SMTP STARTTLS.
CATALYST_SMTP_STARTTLS=0
# API: optional quality report JSON path.
CATALYST_QUALITY_JSON=
# API: set to 1 to enable data refresh endpoints.
CATALYST_DATA_REFRESH=0
# API: warm runtime during startup (1 by default).
CATALYST_WARM_START=1
# API: public source projection limits switch.
CATALYST_PUBLIC_SOURCE_LIMITS=0
# API: selected evidence-window policy.
CATALYST_EVIDENCE_WINDOW_POLICY=desk_cascade_v1
# API: selected retrieval profile.
CATALYST_RETRIEVAL_PROFILE=lexical_display_v1
# API: agent rule switches.
CATALYST_V2_RULES=all
# API: evidence provider selection.
CATALYST_WEB_EVIDENCE=discovery_v2
# API and daily job: enable public Tavily use.
CATALYST_PUBLIC_TAVILY_ENABLED=0
# API and daily job: provider credentials are optional and belong in a local secret store.
DEEPSEEK_API_KEY=
# API: optional credentials are supplied by users as BYOK and are not configured here.
OPENAI_API_KEY=
# API: optional user or service provider credential.
AIHUBMIX_API_KEY=
# Daily job: Finnhub headline discovery credential.
FINNHUB_API_KEY=
# Daily job: Polygon market and filing data credential.
POLYGON_API_KEY=
# Daily job: SEC contact identity; use your own descriptive name and contact outside this template.
SEC_USER_AGENT=
# Daily job: optional Tavily key pool.
TAVILY_API_KEYS=
# API and daily job: optional single Tavily credential when a pool is not set.
TAVILY_API_KEY=
# Daily job: optional Alpaca news account identifier.
APCA_API_KEY_ID=
# Daily job: optional Alpaca news account secret; set only in deployment secrets.
APCA_API_SECRET_KEY=
# Daily job: optional Alpaca data endpoint.
APCA_DATA_URL=
# Daily job: optional FMP key for structured facts.
FMP_API_KEY=
# Daily job: optional FRED key for macro facts.
FRED_API_KEY=
# API and daily job: optional Anthropic provider credential.
ANTHROPIC_API_KEY=
# API and daily job: optional xAI provider credential.
XAI_API_KEY=
# API and daily job: optional Qwen provider credential.
QWEN_API_KEY=
# API and daily job: optional Z.AI/GLM provider credential.
GLM_API_KEY=
# API and daily job: optional SiliconFlow provider credential.
SILICONFLOW_API_KEY=
# API and daily job: optional Gemini provider credential.
GEMINI_API_KEY=
# Daily job: optional status JSON destination.
CATALYST_DAILY_PIPELINE_STATUS=
# Daily job: optional explicit corpus database path.
CATALYST_CORPUS_DB=
# Daily job: optional Alpaca news archive SQLite path.
CATALYST_ALPACA_NEWS_DB=
# Daily job: optional snapshot database path.
CATALYST_SNAPSHOT_DB=
# Daily job: optional daily input manifest path.
CATALYST_INPUT_MANIFEST=
# Daily job: optional input receipt output path.
CATALYST_INPUT_RECEIPT=
# Daily job: optional directory for source archives.
CATALYST_ARCHIVE_DIR=
# Daily job: optional directory for backups.
CATALYST_BACKUP_DIR=
# Daily job: optional shared request-rate limit directory.
CATALYST_RATELIMIT_DIR=
# Daily job: optional resilient ingestion state database.
CATALYST_RESILIENCE_DB=
# Daily job: optional SEC submissions cache directory.
CATALYST_SEC_SUBMISSIONS_DIR=
# Daily job: optional SEC earnings cache path.
CATALYST_SEC_EARNINGS_CACHE=
# Daily job: optional page-version store path.
CATALYST_PAGE_VERSIONS_DB=
# Daily job: optional corporation action store path.
CATALYST_CORP_ACTIONS_DB=
# Daily job: optional news-category store path.
CATALYST_NEWS_CATEGORIES_DB=
# Daily job: optional media store path.
CATALYST_MEDIA_DB=
# Daily job: optional web-search store path.
CATALYST_WEB_SEARCH_DB=
# Daily job: optional static snapshot for ready-range reads.
CATALYST_READY_SNAPSHOT=
# Daily job: enable one-time full-text corpus index rebuilding only when explicitly set.
CATALYST_CORPUS_FTS_REBUILD=0
# Daily job: optional corpus vacuum switch.
CATALYST_CORPUS_VACUUM=0
# Daily job: minimum available disk space for corpus build, in decimal GB.
CATALYST_CORPUS_MIN_FREE_GB=10
# Daily job: optional request worker count.
CATALYST_FETCH_WORKERS=5
# Daily job: optional subject worker count.
CATALYST_SUBJECT_WORKERS=5
# Daily job: optional source relay URL.
CATALYST_RELAY_URL=http://127.0.0.1:8765
# Daily job: comma-separated hosts routed through the optional relay.
CATALYST_RELAY_HOSTS=
# Daily job: set to 1 to prefer IPv4 for provider requests.
CATALYST_PREFER_IPV4=0
# Daily job: set to 1 to use only cached SEC data.
CATALYST_SEC_OFFLINE=0
# Daily job: cap for Tavily credits.
CATALYST_TAVILY_DAILY_CREDITS=50
# Daily job: UTC schedule for an API-triggered update.
CATALYST_DAILY_UPDATE_UTC=11:00
# API: optional featured bundle database path.
CATALYST_FEATURED_BUNDLE=
# API: optional featured bundle manifest path.
CATALYST_FEATURED_MANIFEST=
# API: optional selected filing units.
CATALYST_FILING_UNITS=
# API: optional API key for non-BYOK legacy development mode.
CATALYST_PRIMARY_VERIFIER=0
# Daily job: set to 1 to disable corrective updates for an operator-approved run.
CATALYST_SKIP_CORRECTIVE=0
# Daily job: optional date-independent source policy switch.
CATALYST_TARGET_LANGUAGE=en
# Daily job: minimum extracted content length.
CATALYST_RAG_MIN_CHAR_COUNT=200
# Daily job: duplicate template threshold.
CATALYST_TEMPLATE_SPAM_DUPLICATE_THRESHOLD=5
# Daily job: comma-separated source-priority overrides.
CATALYST_CROSS_SOURCE_PRIORITY=
# Daily job: optional feed URL override.
CATALYST_FEED_URL=
# Daily job: optional retry and rate-limit inputs are managed by the stores above.
CATALYST_DATA_DIR=
# API: enable live SQLite reads for stores updated in place.
CATALYST_SQLITE_LIVE_READ=0
# API: maximum SQLite read retry count.
CATALYST_SQLITE_READ_RETRIES=4
# API: SQLite read timeout in seconds.
CATALYST_SQLITE_READ_TIMEOUT_S=10
# API: legacy cohort selector when using a legacy source adapter.
CATALYST_LEGACY_COHORT=
# API: legacy body store path.
CATALYST_LEGACY_BODY_STORE=
# API: legacy catalog directory.
CATALYST_LEGACY_CATALOG_DIR=
# API: expected legacy store SHA-256.
CATALYST_LEGACY_STORE_SHA256=
# API: legacy alias for Qwen provider credentials.
DASHSCOPE_API_KEY=
# API: legacy alias for Z.AI provider credentials.
ZAI_API_KEY=
# API: expected corpus manifest identity enforced at startup.
CATALYST_CORPUS_MANIFEST_ID=
# API: expected full-text index digest enforced at startup.
CATALYST_EXPECTED_FTS_DIGEST=
# API: optional SQLite projection database for SEC filing reads.
CATALYST_SEC_FILING_PROJECTION_DB=
# API: optional served-projection scratch directory.
CATALYST_SERVED_PROJECTION_DIR=
# API: optional report identifier for post-build readiness.
CATALYST_POSTBUILD_READINESS_ID=
# API: optional report identifier for data probe results.
CATALYST_PROBE_REPORT_ID=
# API: optional source-bundle identity override.
CATALYST_SOURCE_BUNDLE_ID=
# API: optional snapshot identity override.
CATALYST_SNAPSHOT_ID=
# API: optional timing artifact output path.
CATALYST_AG_TIMINGS_PATH=
# API: enable second-stage cascade retrieval when set to 1.
CATALYST_CASCADE_STAGE2=0
# API: optional investigator label for run metadata.
CATALYST_INVESTIGATOR=
# API: enable recording provider interactions in local development.
CATALYST_LLM_RECORD=0
# API: enable recording provider misses in local development.
CATALYST_LLM_RECORD_MISSES=0
# API: enable replaying provider interactions in local development.
CATALYST_LLM_REPLAY=0
# API: include provider reasoning traces when supported by the selected model.
CATALYST_VERIFIER_REASONING=0
# API: allow on-demand web evidence when the deployment policy permits it.
CATALYST_WEB_ON_DEMAND=0
# API: optional reported-reason tag used by run annotation tools.
CATALYST_REPORTED_REASON=
