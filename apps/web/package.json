{
  "name": "catalyst-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../../contracts/openapi.json -o src/api/schema.d.ts",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen": "npm run gen:api && npm run gen:tokens",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check:classes": "node scripts/check-classes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@microsoft/fetch-event-source": "2.0.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lightweight-charts": "5.3.0",
    "lucide-react": "1.73.0",
    "openapi-fetch": "0.14.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
